# ============================================================
# BMC 日志分析系统 —— LLM 配置
# ============================================================
# 复制此文件为 .env 并填入你的配置

# ---- LLM 提供商 ----
# openai    = OpenAI 官方（使用 OPENAI_API_KEY）
# ollama    = 本地 Ollama（需设置 LLM_API_BASE）
# custom    = 其他 OpenAI 兼容接口
LLM_PROVIDER=openai

# ---- 模型名称 ----
# OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
# Ollama: qwen2.5, llama3, deepseek-r1, mistral
LLM_MODEL=gpt-4o-mini

# ---- API 密钥 ----
# OpenAI: sk-xxx
# Ollama: 留空（本地无需密钥）
LLM_API_KEY=

# ---- 自定义 API 地址（Ollama / 代理 / 兼容服务）----
# Ollama 默认: http://localhost:11434/v1
# 不使用则留空
LLM_API_BASE=

# ---- 生成参数 ----
# 温度（0-2）：越低越确定，日志分析建议 0.1-0.3
LLM_TEMPERATURE=0.3

# 最大输出 token 数
LLM_MAX_TOKENS=4096

# ---- Agent 参数 ----
# Agent 最大工具调用轮次
AGENT_MAX_ITERATIONS=10

# 对话历史最大保留条数
AGENT_MAX_HISTORY=40
